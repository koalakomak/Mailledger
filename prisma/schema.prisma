datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String                  @id @default(uuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  lastLoginAt            DateTime?               @map("last_login_at")

  accounts               Account[]
  userSources            UserSource[]
  spreadsheetConnections SpreadsheetConnection[]
  transactions           Transaction[]
  transactionLogs        TransactionLog[]
  categoryRules          UserCategoryRule[]

  @@map("users")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  type                  String
  provider              String
  providerAccountId     String    @map("provider_account_id")
  refresh_token         String?   @db.Text
  access_token          String?   @db.Text
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?   @db.Text
  session_state         String?
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSources            UserSource[]
  spreadsheetConnections SpreadsheetConnection[]

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Source {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  parserType  String   @map("parser_type")
  filterQuery String   @map("filter_query")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userSources  UserSource[]
  transactions Transaction[]

  @@map("sources")
}

model UserSource {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  sourceId     String    @map("source_id")
  accountId    String?   @map("account_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source  Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceId])
  @@map("user_sources")
}

model SpreadsheetConnection {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  accountId     String?   @map("account_id")
  spreadsheetId String    @map("spreadsheet_id")
  sheetName     String    @default("Transactions") @map("sheet_name")
  columnMapping Json?     @map("column_mapping")
  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("spreadsheet_connections")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  AUTO
  REVIEW
  CONFIRMED
  REJECTED
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  sourceId        String            @map("source_id")
  emailMessageId  String            @map("email_message_id")
  emailThreadId   String?           @map("email_thread_id")
  emailSubject    String?           @map("email_subject")
  emailReceivedAt DateTime          @map("email_received_at")
  transactionDate DateTime          @map("transaction_date")
  description     String
  merchant        String
  type            TransactionType   @default(EXPENSE)
  amount          Decimal           @db.Decimal(15, 2)
  currency        String            @default("IDR")
  category        String?
  status          TransactionStatus @default(REVIEW)
  confidence      Int               @default(0)
  rawData         Json?             @map("raw_data")
  isSyncedToSheet Boolean           @default(false) @map("is_synced_to_sheet")
  syncedToSheetAt DateTime?         @map("synced_to_sheet_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  transactionLogs TransactionLog[]

  @@unique([userId, emailMessageId])
  @@index([userId, status])
  @@index([userId, transactionDate])
  @@map("transactions")
}

model TransactionLog {
  id            String       @id @default(uuid())
  transactionId String?      @map("transaction_id")
  userId        String?      @map("user_id")
  status        String
  message       String
  payload       Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transaction_logs")
}

model UserCategoryRule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  keyword   String
  category  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_category_rules")
}
