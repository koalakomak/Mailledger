# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailledger?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mailledger?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-random-key-at-least-32-chars-long"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Encryption Key (32-byte hex or base64 key for encrypting refresh tokens at rest)
GOOGLE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis (BullMQ / Caching)
REDIS_URL="redis://localhost:6379"

# Sentry (Optional for error tracking)
SENTRY_DSN=""

# Vercel Cron (Optional: bearer token that protects /api/cron/sync from public triggers — leave empty to disable the check)
CRON_SECRET=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# IMPORTANT: do NOT set NODE_ENV manually — Next.js manages it (development/test/production).
# Setting NODE_ENV="development" breaks `next build` (dev runtime + prerender failures).
